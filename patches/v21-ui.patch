+.truthtrace{margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}.truthtrace-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:9px}.truth-claim{padding:10px;margin:8px 0;border:1px solid var(--line);border-radius:12px;background:var(--panel2)}.truth-claim>div:first-child{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.truth-type{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:var(--accent)}.truth-confidence{font:800 11px ui-monospace,monospace;color:var(--muted);margin-left:auto}.truth-sources{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.truth-source{border:1px solid var(--line);border-radius:9px;background:var(--panel);color:var(--text);padding:6px 8px;font-size:11px;cursor:pointer;text-align:left}.truth-source:hover{border-color:var(--accent)}.truth-source.text-only{cursor:default;color:var(--muted)}.comparison-area{margin-top:12px}.comparison-card{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:13px}.comparison-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:9px}.change-list{display:grid;gap:7px}.change-item{display:grid;grid-template-columns:90px 1fr;gap:10px;padding:9px;border-left:3px solid var(--line);background:var(--panel2);border-radius:8px}.change-item.importance-high{border-left-color:var(--danger)}.change-item.importance-medium{border-left-color:#f59e0b}.change-item.importance-low{border-left-color:var(--accent)}.change-type{text-transform:uppercase;font-size:10px;font-weight:900;color:var(--muted)}.change-item del{color:var(--muted)}.memory-results{margin-top:16px;max-height:55vh;overflow:auto}.memory-answer{padding:12px;border-radius:12px;background:var(--panel2);border:1px solid var(--line)}.memory-source{width:100%;display:grid;gap:4px;text-align:left;padding:10px;margin:7px 0;border:1px solid var(--line);border-radius:11px;background:var(--panel2);color:var(--text);cursor:pointer}.memory-source:hover{border-color:var(--accent)}.memory-source span,.memory-source small{color:var(--muted)}.actions-content{display:grid;gap:9px;max-height:65vh;overflow:auto}.action-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:11px;border:1px solid var(--line);border-radius:12px;background:var(--panel2)}.action-row.done{opacity:.58}.action-row.done strong{text-decoration:line-through}.action-info{min-width:0}.action-done{text-decoration:line-through;opacity:.65}.focus-flash{outline:3px solid color-mix(in srgb,var(--accent) 55%,transparent);outline-offset:3px;transition:outline-color .5s}.modal h5{margin:10px 0 4px}@media(max-width:640px){.action-row,.change-item{grid-template-columns:1fr}.truth-confidence{margin-left:0}.action-row .button-row{justify-content:flex-start}}
