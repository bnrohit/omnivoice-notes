# Server only. Never place secrets in browser code.
OPENAI_API_KEY=
PORT=3000
MAX_AUDIO_MB=18
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-5.6-luna

# Optional provider hook for speaker diarization.
# POST raw JSON {audioBase64,mimeType,fileName,language} and return {segments:[{startMs,endMs,speaker,text}]}
DIARIZATION_ENDPOINT=
DIARIZATION_BEARER_TOKEN=

# Optional fixed outbound integration hook. OmniVoice never accepts arbitrary webhook targets from browsers.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_BEARER_TOKEN=

# Encrypted transcript/note shares are opaque ciphertext on disk. Audio is not uploaded by v2 secure sharing.
SHARE_TTL_HOURS=168
MAX_SHARE_KB=512
